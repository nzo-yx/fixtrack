@{
    ViewData["Title"] = "Resident Dashboard";
    var displayName = ViewData["ResidentName"] as string ?? "Resident";
}
<section class="min-h-screen bg-[#F8FAFC] text-[#151F49]">
    <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-4">
            <a asp-controller="Home" asp-action="Index" aria-label="FixTrack home" class="text-xl font-extrabold tracking-tight">Fix<span class="text-[#228B74]">Track</span></a>
            <div class="flex items-center gap-4">
                <span class="text-sm text-slate-600">Resident Portal</span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-md border border-slate-300 px-4 py-2 text-sm font-semibold hover:bg-slate-100">Log out</button>
                </form>
            </div>
        </div>
    </header>
    <main class="mx-auto max-w-6xl px-6 py-12">
        <p class="mb-2 text-sm font-bold uppercase tracking-widest text-[#228B74]">Resident Dashboard</p>
        <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl">Welcome, @displayName</h1>
        <p class="mt-3 max-w-2xl text-slate-600">Your community reports will appear here once the reporting feature is ready.</p>
        <div class="mt-10 grid gap-6 md:grid-cols-2">
            <section class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
                <h2 class="text-xl font-bold">Submit a report</h2>
                <p class="mt-2 text-slate-600">You'll be able to report community concerns with photos, location and a description.</p>
                <span class="mt-6 inline-block rounded-lg bg-slate-100 px-4 py-3 text-sm font-semibold text-slate-500">Coming in the next checkpoint</span>
            </section>
            <section class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
                <h2 class="text-xl font-bold">My report history</h2>
                <p class="mt-2 text-slate-600">There are no reports to display yet. We'll connect this section to real database records when reporting is implemented.</p>
                <div class="mt-6 rounded-xl border border-dashed border-slate-300 bg-[#F8FAFC] p-6 text-center text-sm text-slate-500">No reports yet</div>
            </section>
        </div>
    </main>
</section>
