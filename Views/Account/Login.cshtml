@model FixTrack.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log In";
}
<section class="min-h-screen bg-white px-5 py-16 text-[#151F49]">
    <div class="mx-auto max-w-lg">
        <a asp-controller="Home" asp-action="Index" class="text-sm font-semibold">&larr; Back to FixTrack</a>
        <h1 class="mt-10 text-4xl font-extrabold tracking-tight">Welcome back</h1>
        <p class="mt-3 text-slate-600">Sign in to your FixTrack account.</p>

        @if (TempData["RegistrationSuccess"] is string success)
        {
            <div role="status" class="mt-8 rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-emerald-900">@success</div>
        }

        <form asp-controller="Account" asp-action="Login" method="post" class="mt-8 space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="All" class="text-sm text-red-700"></div>
            <div>
                <label asp-for="Email" class="mb-1 block text-sm font-semibold"></label>
                <input asp-for="Email" autocomplete="username" class="w-full rounded-md border border-slate-300 p-3 text-slate-900" />
                <span asp-validation-for="Email" class="text-sm text-red-700"></span>
            </div>
            <div>
                <label asp-for="Password" class="mb-1 block text-sm font-semibold"></label>
                <input asp-for="Password" autocomplete="current-password" class="w-full rounded-md border border-slate-300 p-3 text-slate-900" />
                <span asp-validation-for="Password" class="text-sm text-red-700"></span>
            </div>
            <label class="flex items-center gap-2 text-sm">
                <input asp-for="RememberMe" class="accent-[#151F49]" /> Remember me
            </label>
            <button type="submit" class="w-full rounded-md bg-[#8BE9B5] p-3 font-bold text-[#151F49] hover:bg-[#A5F0C8]">Log in</button>
        </form>
        <p class="mt-5 text-sm text-slate-600">New to FixTrack? <a asp-controller="Account" asp-action="Register" class="font-bold underline">Create an account</a></p>
    </div>
</section>
