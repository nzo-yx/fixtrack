@model FixTrack.Web.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Resident Account";
}

<section class="min-h-screen bg-white px-5 py-16 text-[#151F49]">
    <div class="mx-auto max-w-lg">
        <a asp-controller="Home" asp-action="Index" class="text-sm font-semibold text-[#151F49]">← Back to FixTrack</a>
        <h1 class="mt-10 text-4xl font-extrabold tracking-tight">Create your resident account</h1>
        <p class="mt-3 text-slate-600">Report issues and keep a history of your community reports.</p>

        @if (TempData["RegistrationSuccess"] is string success)
        {
            <div role="status" class="mt-8 rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-emerald-900">@success</div>
        }

        <form asp-controller="Account" asp-action="Register" method="post" class="mt-8 space-y-5 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-sm text-red-700"></div>

            <div>
                <label asp-for="FullName" class="mb-1 block text-sm font-semibold"></label>
                <input asp-for="FullName" autocomplete="name" class="w-full rounded-md border border-slate-300 p-3 text-slate-900" />
                <span asp-validation-for="FullName" class="text-sm text-red-700"></span>
            </div>
            <div>
                <label asp-for="Email" class="mb-1 block text-sm font-semibold"></label>
                <input asp-for="Email" autocomplete="email" class="w-full rounded-md border border-slate-300 p-3 text-slate-900" />
                <span asp-validation-for="Email" class="text-sm text-red-700"></span>
            </div>
            <div>
                <label asp-for="PhoneNumber" class="mb-1 block text-sm font-semibold"></label>
                <input asp-for="PhoneNumber" type="tel" inputmode="tel" autocomplete="tel"
                       placeholder="09171234567" maxlength="13"
                       class="w-full rounded-md border border-slate-300 p-3 text-slate-900" />
                <span asp-validation-for="PhoneNumber" class="text-sm text-red-700"></span>
                <p class="mt-1 text-xs text-slate-500">For future report updates and OTP verification. Not verified yet.</p>
            </div>
            <div>
                <label asp-for="Password" class="mb-1 block text-sm font-semibold"></label>
                <input asp-for="Password" autocomplete="new-password" class="w-full rounded-md border border-slate-300 p-3 text-slate-900" />
                <span asp-validation-for="Password" class="text-sm text-red-700"></span>
            </div>
            <div>
                <label asp-for="ConfirmPassword" class="mb-1 block text-sm font-semibold"></label>
                <input asp-for="ConfirmPassword" autocomplete="new-password" class="w-full rounded-md border border-slate-300 p-3 text-slate-900" />
                <span asp-validation-for="ConfirmPassword" class="text-sm text-red-700"></span>
            </div>
            <button type="submit" class="w-full rounded-md bg-[#8BE9B5] p-3 font-bold text-[#151F49] hover:bg-[#A5F0C8]">Create account</button>
        </form>
        <p class="mt-4 text-sm text-slate-500">For testing only: login and the resident dashboard will be added later.</p>
    </div>
</section>
